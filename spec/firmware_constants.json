  "decisoes_manuais_inerentes": [
    {
      "id": "DM-01",
      "modulo": "sensor",
      "constante": "SENSOR_WDT_TIMEOUT_MS",
      "valor": null,
      "tipo_c": "uint32_t",
      "classe": "HARDCODED_JUSTIFICADO",
      "justificativa": "Timeout do WDT nao e parametro de dominio. Calculado como duracao_max_loop_ms multiplicado por fator de seguranca. Determinar apos medir o loop mais longo na implementacao. Comentario obrigatorio com o calculo explicito."
    },
    {
      "id": "DM-02",
      "modulo": "sensor",
      "constante": "SENSOR_ADC_ATENUACAO",
      "valor": "ADC_11db",
      "tipo_c": "adc_attenuation_t",
      "classe": "HARDCODED_JUSTIFICADO",
      "tipo_plataforma": true,
      "justificativa": "Tipo da camada Arduino (Arduino ESP32 3.x / IDF5) para range 0-3.3V no ADC1. adc_attenuation_t substitui adc_atten_t (ESP-IDF direto) a partir do Arduino ESP32 3.x. Nao e parametro de dominio; e configuracao de silicio. Nao existe campo correspondente em nenhum spec JSON."
    },
    {
      "id": "DM-03",
      "modulo": "visual",
      "constante": "VISUAL_COLOR_ORDER",
      "valor": "GRB",
      "tipo_c": "EOrder",
      "classe": "HARDCODED_JUSTIFICADO",
      "tipo_plataforma": true,
      "justificativa": "GRB e enum da biblioteca FastLED. visual.json#componente.color_order registra 'GRB' como string; o simbolo C++ e fornecido pela API da biblioteca e nao pode ser parametrizado sem reflexao."
    }
