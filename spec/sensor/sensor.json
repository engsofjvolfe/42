    "tensao_pico_min_v": 5,
    "tensao_pico_max_v": 50,
    "quantidade": 4
  },

  "circuito_protecao": {
    "r1_ohm": 1000000,
    "r1_potencia_w": 0.25,
    "d1_tensao_zener_v": 3.3,
