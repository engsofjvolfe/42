    {"id": "CA-02-03", "isolamento_entre_zonas": true},
    {"id": "CA-02-04", "impactos_fortes_total": 100, "gpio_danificado": false},
    {"id": "CA-02-05", "eventos_por_batida": 1},
    {"id": "CA-02-06", "latencia_maxima_ms": 10}
  ]
